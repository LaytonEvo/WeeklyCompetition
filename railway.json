{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "buildCommand": "pnpm build" },
  "deploy": {
    "preDeployCommand": ["pnpm release"],
    "startCommand": "pnpm start:prod",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE"
  }
}
