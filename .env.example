# ---- Core ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pinhunters
# Public base URL used in emails, QR codes, Stripe redirects
APP_URL=http://localhost:3000
# 32+ random bytes, used to sign evidence URLs and other tokens: `openssl rand -hex 32`
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Protects /api/cron/* endpoints (Vercel Cron sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=change-me-cron-secret

# ---- Stripe (test mode until launch gate is approved) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to "true" only after legal approval AND live keys are configured
STRIPE_LIVE_MODE_ALLOWED=false

# ---- Email ----
# "log" (development: stores in DB + console), "resend" or "postmark"
EMAIL_PROVIDER=log
EMAIL_FROM="Pin Hunters <pinhunters@example.com>"
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

# ---- Evidence file storage ----
# "local" (development only — writes to ./storage) or "s3" (any S3-compatible bucket, private)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=eu-west-2
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Development helpers ----
# When "true", magic-link URLs are shown on screen instead of only emailed (NEVER in production)
DEV_SHOW_MAGIC_LINKS=true
